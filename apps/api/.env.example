# Backend API Key (server-side only - DO NOT use VITE_ prefix)
LTA_DATAMALL_API_KEY=your_api_key_here

# API port (optional, defaults to 3001)
PORT=3001

# Bind address (optional, defaults to 127.0.0.1 so only the local reverse
# proxy can reach the API). Use 0.0.0.0 to listen on all interfaces.
# HOST=127.0.0.1

# ============================================
# DEV MODE (optional)
# ============================================
# For local development with custom ports, create a .env.dev file:
# LTA_DATAMALL_API_KEY=your_api_key_here
# PORT=3002  # Dev backend port (production uses 3001)

# ============================================
# ANALYTICS
# ============================================
# Days of analytics data to keep (default 180)
# ANALYTICS_RETENTION_DAYS=180
# Private dashboard: binds 127.0.0.1 only, expose with
#   tailscale serve --bg --https=8443 http://127.0.0.1:3010
# DASHBOARD_PORT=3010
# DASHBOARD_ENABLED=true
# Comma-separated Tailscale login names allowed to view the dashboard.
# If empty, any tailnet user (any request carrying Tailscale-User-Login) is allowed.
DASHBOARD_ALLOWED_USERS=you@example.com
